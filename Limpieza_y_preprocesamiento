import pandas as pd
import numpy as np

# -------------------------------------------------------------------------
# 1. CARGA DEL DATASET ORIGINAL
# -------------------------------------------------------------------------
archivo_origen = "eph_tecnologia_microdatos.csv"

try:
    df_raw = pd.read_csv(archivo_origen, sep=',')
    if df_raw.shape[1] == 1:
        df_raw = pd.read_csv(archivo_origen, sep=';')
except Exception:
    df_raw = pd.read_csv(archivo_origen, sep=';')

print(f"Dimensiones iniciales: {df_raw.shape[0]} registros y {df_raw.shape[1]} columnas.")

# -------------------------------------------------------------------------
# 2. TRATAMIENTO DE CÓDIGOS DE NO RESPUESTA (INCONSISTENCIAS)
# -------------------------------------------------------------------------
df_clean = df_raw.copy()

# En la EPH, códigos como -9, -1, 99 y 999 indican datos faltantes o no respuesta
codigos_no_respuesta = [-9, -1, 99, 999]
df_clean.replace(codigos_no_respuesta, np.nan, inplace=True)

# -------------------------------------------------------------------------
# 3. SELECCIÓN DE VARIABLES CLAVE PARA LA INVESTIGACIÓN
# -------------------------------------------------------------------------
# Variables independientes: IPCF, NIVEL_ED, REGION
# Variables dependientes: II7 (Internet), II8 (Computadora)
columnas_relevantes = ['IPCF', 'II7', 'II8', 'NIVEL_ED', 'REGION']

# Conservar identificadores si existen en la base
for col_id in ['CODUSU', 'NRO_HOGAR', 'PONDERA']:
    if col_id in df_clean.columns:
        columnas_relevantes.append(col_id)

columnas_existentes = [col for col in columnas_relevantes if col in df_clean.columns]
df_clean = df_clean[columnas_existentes].copy()

# -------------------------------------------------------------------------
# 4. RECODIFICACIÓN DE VARIABLES CATEGÓRICAS Y TECNOLÓGICAS
# -------------------------------------------------------------------------
# En el cuestionario EPH: 1 = Sí, 2 = No.
# Se recodifican a formato binario (1 = Tiene, 0 = No tiene) para el análisis estadístico
mapeo_binario = {1: 1, 2: 0}

if 'II7' in df_clean.columns:
    df_clean['II7_binaria'] = df_clean['II7'].map(mapeo_binario)
    df_clean['II7_desc'] = df_clean['II7_binaria'].map({1: 'Con Internet', 0: 'Sin Internet'})

if 'II8' in df_clean.columns:
    df_clean['II8_binaria'] = df_clean['II8'].map(mapeo_binario)
    df_clean['II8_desc'] = df_clean['II8_binaria'].map({1: 'Con Computadora', 0: 'Sin Computadora'})

# Mapeo de Regiones EPH para facilitar la interpretación territorial
mapeo_regiones = {
    1: 'Gran Buenos Aires',
    40: 'NOA',
    41: 'NEA',
    42: 'Cuyo',
    43: 'Pampeana',
    44: 'Patagonia'
}
if 'REGION' in df_clean.columns:
    df_clean['REGION_desc'] = df_clean['REGION'].map(mapeo_regiones)

# Mapeo de Nivel Educativo simplificado
mapeo_educativo = {
    1: 'Primaria Incompleta',
    2: 'Primaria Completa',
    3: 'Secundaria Incompleta',
    4: 'Secundaria Completa',
    5: 'Superior/Universitario Incompleto',
    6: 'Superior/Universitario Completo',
    7: 'Sin Instrucción'
}
if 'NIVEL_ED' in df_clean.columns:
    df_clean['NIVEL_ED_desc'] = df_clean['NIVEL_ED'].map(mapeo_educativo)

# -------------------------------------------------------------------------
# 5. FILTRADO DE VALORES ATÍPICOS / INVÁLIDOS EN INGRESOS
# -------------------------------------------------------------------------
# Excluir ingresos per cápita negativos si existieran
if 'IPCF' in df_clean.columns:
    df_clean = df_clean[df_clean['IPCF'].isna() | (df_clean['IPCF'] >= 0)]

# -------------------------------------------------------------------------
# 6. EXPORTACIÓN DEL DATASET FINAL NORMALIZADO
# -------------------------------------------------------------------------
df_clean.to_csv("df_clean.csv", index=False)
print("Pipeline de preprocesamiento ejecutado con éxito.")
print(f"Dataset exportado: 'df_clean.csv' con {df_clean.shape[0]} filas y {df_clean.shape[1]} columnas.")
