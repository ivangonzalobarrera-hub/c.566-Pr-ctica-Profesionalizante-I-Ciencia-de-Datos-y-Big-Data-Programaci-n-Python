import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Carga del archivo original
# Ajustamos el separador por si viene delimitado por punto y coma
df_raw = pd.read_csv("eph_tecnologia_microdatos.csv", sep=';')

# 2. Limpieza de valores inconsistentes y de no-respuesta (Clase 2)
df_clean = df_raw.copy()
# Reemplazamos los códigos típicos de la EPH que ensucian los promedios
df_clean.replace([-9, -1, 99, 999], np.nan, inplace=True)

# 3. Recodificación de variables dependientes (Tecnología)
# Convertimos el 2 ("No") en 0 para poder calcular promedios y proporciones fácilmente
df_clean['II7_bin'] = df_clean['II7'].replace(2, 0) # Internet
df_clean['II8_bin'] = df_clean['II8'].replace(2, 0) # Computadora

# Creamos etiquetas de texto para que los gráficos queden más presentables
df_clean['Tiene_Internet'] = df_clean['II7'].map({1: 'Sí', 2: 'No'})
df_clean['Tiene_PC'] = df_clean['II8'].map({1: 'Sí', 2: 'No'})

# 4. Guardamos la base procesada para las siguientes clases
df_clean.to_csv("df_clean.csv", index=False)
print("Dataset limpio y recodificado guardado exitosamente como df_clean.csv")
